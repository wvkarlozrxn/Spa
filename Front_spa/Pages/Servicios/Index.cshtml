@page
@model Front_spa.Pages.Servicios.IndexModel
@{
    ViewData["Title"] = "Servicios";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Servicios</h2>
    @if (HttpContext.Session.GetString("Rol") == "Administrador")
    {
        <a asp-page="Crear" class="btn btn-primary">Nuevo servicio</a>
    }
</div>

@if (!string.IsNullOrEmpty(Model.Mensaje))
{
    <div class="alert alert-danger">@Model.Mensaje</div>
}

<table class="table table-striped">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Descripción</th>
            <th>Duración (min)</th>
            <th>Precio</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var servicio in Model.Lista)
        {
            <tr>
                <td>@servicio.Nombre</td>
                <td>@servicio.Descripcion</td>
                <td>@servicio.Duracion</td>
                <td>@servicio.Precio.ToString("N0")</td>
                <td class="text-end">
                    @if (HttpContext.Session.GetString("Rol") == "Administrador")
                    {
                        <a asp-page="Editar" asp-route-id="@servicio.Id_Servicio" class="btn btn-sm btn-outline-primary">Editar</a>
                        <form method="post" asp-page-handler="Eliminar" asp-route-id="@servicio.Id_Servicio" class="d-inline"
                              onsubmit="return confirm('¿Eliminar este servicio?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
