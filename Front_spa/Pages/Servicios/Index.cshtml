@page
@model Front_spa.Pages.Servicios.IndexModel
@{
    ViewData["Title"] = "Servicios";
}

<h2 class="mb-3">Servicios</h2>

<form method="post">

    @if (!string.IsNullOrEmpty(Model.Mensaje))
    {
        <div class="alert alert-danger">@Model.Mensaje</div>
    }

    @if (Model.Formulario || Model.Borrar)
    {
        <input type="hidden" asp-for="Actual.Id_Servicio" />
    }

    @if (!Model.Formulario)
    {
        <div class="row g-2 mb-3">
            <div class="col-md-4">
                <input asp-for="Filtro.Nombre" class="form-control" placeholder="Nombre" />
            </div>
            <div class="col-md-8">
                <input type="submit" value="Consultar" class="btn btn-secondary"
                       asp-page-handler="BtConsultar" />
                @if (Model.EsAdmin)
                {
                    <input type="submit" value="Nuevo" class="btn btn-primary"
                           asp-page-handler="BtNuevo" />
                }
            </div>
        </div>
    }

    @if (Model.Formulario)
    {
        <div style="max-width:450px">
            <h4>Servicio</h4>

            <div class="mb-3">
                <label class="form-label">Nombre</label>
                <input asp-for="Actual.Nombre" class="form-control" />
            </div>
            <div class="mb-3">
                <label class="form-label">Descripción</label>
                <input asp-for="Actual.Descripcion" class="form-control" />
            </div>
            <div class="mb-3">
                <label class="form-label">Duración (minutos)</label>
                <input asp-for="Actual.Duracion" type="number" class="form-control" />
            </div>
            <div class="mb-3">
                <label class="form-label">Precio</label>
                <input asp-for="Actual.Precio" type="number" class="form-control" />
            </div>

            <input type="submit" value="Guardar" class="btn btn-primary"
                   asp-page-handler="BtGuardar" />
            <input type="submit" value="Cancelar" class="btn btn-secondary"
                   asp-page-handler="BtConsultar" />
        </div>
    }

    @if (Model.Borrar)
    {
        <div class="alert alert-warning">
            <h5>¿Quiere borrar el servicio @Model.Actual.Nombre?</h5>
            <input type="submit" value="Cancelar" class="btn btn-secondary"
                   asp-page-handler="BtConsultar" />
            <input type="submit" value="Borrar" class="btn btn-danger"
                   asp-page-handler="BtBorrar" />
        </div>
    }

    @if (!Model.Formulario)
    {
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Descripción</th>
                    <th>Duración</th>
                    <th>Precio</th>
                    @if (Model.EsAdmin)
                    {
                        <th></th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var elemento in Model.Lista)
                {
                    <tr>
                        <td>@elemento.Nombre</td>
                        <td>@elemento.Descripcion</td>
                        <td>@elemento.Duracion min</td>
                        <td>@elemento.Precio.ToString("N0")</td>
                        @if (Model.EsAdmin)
                        {
                            <td class="text-end">
                                <input type="submit" value="Editar" class="btn btn-sm btn-outline-primary"
                                       asp-page-handler="BtEditar"
                                       asp-route-data="@elemento.Id_Servicio" />
                                <input type="submit" value="Borrar" class="btn btn-sm btn-outline-danger"
                                       asp-page-handler="BtPregBorrar"
                                       asp-route-data="@elemento.Id_Servicio" />
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    }

</form>
