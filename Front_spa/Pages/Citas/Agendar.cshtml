@page
@model Front_spa.Pages.Citas.AgendarModel
@{
    ViewData["Title"] = "Agendar cita";
}

<h2 class="mb-3">Agendar cita</h2>

@if (!string.IsNullOrEmpty(Model.Mensaje))
{
    <div class="alert alert-danger">@Model.Mensaje</div>
}

<form method="post" style="max-width:450px">
    <div class="mb-3">
        <label asp-for="IdCliente" class="form-label">Clienta</label>
        <select asp-for="IdCliente" asp-items="Model.Clientas" class="form-select">
            <option value="0">Selecciona una clienta</option>
        </select>
    </div>
    <div class="mb-3">
        <label asp-for="IdServicio" class="form-label">Servicio</label>
        <select asp-for="IdServicio" asp-items="Model.Servicios" class="form-select">
            <option value="0">Selecciona un servicio</option>
        </select>
    </div>
    <div class="mb-3">
        <label asp-for="IdEmpleado" class="form-label">Empleado</label>
        <select asp-for="IdEmpleado" asp-items="Model.Empleados" class="form-select">
            <option value="0">Selecciona un empleado</option>
        </select>
    </div>
    <div class="mb-3">
        <label asp-for="Fecha" class="form-label">Fecha y hora</label>
        <input asp-for="Fecha" type="datetime-local" class="form-control" />
    </div>
    <button type="submit" class="btn btn-primary">Agendar</button>
    <a asp-page="Index" class="btn btn-secondary">Cancelar</a>
</form>
