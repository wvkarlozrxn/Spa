@page
@model Front_spa.Pages.Productos.IndexModel
@{
    ViewData["Title"] = "Productos";
}

<h2 class="mb-3">Productos</h2>

<form method="post" enctype="multipart/form-data">

    @if (!string.IsNullOrEmpty(Model.Mensaje))
    {
        <div class="alert alert-danger">@Model.Mensaje</div>
    }

    @if (Model.Formulario || Model.Borrar)
    {
        <input type="hidden" asp-for="Actual.Id_Producto" />
        <input type="hidden" asp-for="Actual.Id_Inventario" />
        <input type="hidden" asp-for="Inventario.Id_Inventario" />
    }

    @if (!Model.Formulario)
    {
        <div class="row g-2 mb-3">
            <div class="col-md-4">
                <input asp-for="Buscar" class="form-control" placeholder="Nombre" />
            </div>
            <div class="col-md-8">
                <input type="submit" value="Consultar" class="btn btn-secondary"
                       asp-page-handler="BtConsultar" />
                <input type="submit" value="Nuevo" class="btn btn-primary"
                       asp-page-handler="BtNuevo" />
            </div>
        </div>
    }

    @if (Model.Formulario)
    {
        <div style="max-width:450px">
            <h4>Producto</h4>

            <div class="mb-3">
                <label class="form-label">Nombre</label>
                <input asp-for="Actual.Nombre" class="form-control" />
            </div>
            <div class="mb-3">
                <label class="form-label">Descripción</label>
                <input asp-for="Actual.Descripcion" class="form-control" />
            </div>
            <div class="mb-3">
                <label class="form-label">Precio de compra</label>
                <input asp-for="Actual.Precio_Compra" type="number" class="form-control" />
            </div>
            <div class="mb-3">
                <label class="form-label">Precio de venta</label>
                <input asp-for="Actual.Precio_Venta" type="number" class="form-control" />
            </div>
            <div class="mb-3">
                <label class="form-label">Cantidad en inventario</label>
                <input asp-for="Inventario.Cantidad" type="number" class="form-control" />
            </div>
            <div class="mb-3">
                <label class="form-label">Stock mínimo</label>
                <input asp-for="Inventario.Stock_min" type="number" class="form-control" />
            </div>
            <div class="mb-3">
                <label class="form-label">Imagen</label>
                @if (Model.Actual.Imagen != null)
                {
                    <div class="mb-2">
                        <img height="100" width="100"
                             src="data:image;base64,@Model.Actual.Imagen" />
                    </div>
                }
                <input type="file" asp-for="Archivo" class="form-control" accept="image/*" />
            </div>

            <input type="submit" value="Guardar" class="btn btn-primary"
                   asp-page-handler="BtGuardar" />
            <input type="submit" value="Cancelar" class="btn btn-secondary"
                   asp-page-handler="BtConsultar" />
        </div>
    }

    @if (Model.Borrar)
    {
        <div class="alert alert-warning">
            <h5>¿Quiere borrar el producto @Model.Actual.Nombre?</h5>
            <input type="submit" value="Cancelar" class="btn btn-secondary"
                   asp-page-handler="BtConsultar" />
            <input type="submit" value="Borrar" class="btn btn-danger"
                   asp-page-handler="BtBorrar" />
        </div>
    }

    @if (!Model.Formulario)
    {
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Imagen</th>
                    <th>Nombre</th>
                    <th>Descripción</th>
                    <th>Precio de compra</th>
                    <th>Precio de venta</th>
                    <th>Stock</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var elemento in Model.Lista)
                {
                    var inventario = Model.InventarioDe(elemento.Id_Inventario);
                    <tr>
                        <td>
                            @if (elemento.Imagen != null)
                            {
                                <img height="60" width="60"
                                     src="data:image;base64,@elemento.Imagen" />
                            }
                        </td>
                        <td>@elemento.Nombre</td>
                        <td>@elemento.Descripcion</td>
                        <td>@elemento.Precio_Compra.ToString("N0")</td>
                        <td>@elemento.Precio_Venta.ToString("N0")</td>
                        <td>
                            @inventario?.Cantidad
                            @if (inventario != null && inventario.Cantidad <= inventario.Stock_min)
                            {
                                <span class="badge bg-danger">Stock bajo</span>
                            }
                        </td>
                        <td class="text-end">
                            <input type="submit" value="Editar" class="btn btn-sm btn-outline-primary"
                                   asp-page-handler="BtEditar"
                                   asp-route-data="@elemento.Id_Producto" />
                            <input type="submit" value="Borrar" class="btn btn-sm btn-outline-danger"
                                   asp-page-handler="BtPregBorrar"
                                   asp-route-data="@elemento.Id_Producto" />
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

</form>
