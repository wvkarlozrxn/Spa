@page "{id:int}"
@model Front_spa.Pages.Facturas.PagarModel
@{
    ViewData["Title"] = "Registrar pago";
}

<h2 class="mb-3">Registrar pago</h2>

@if (!string.IsNullOrEmpty(Model.Mensaje))
{
    <div class="alert alert-danger">@Model.Mensaje</div>
}

@if (Model.Factura != null)
{
    <p>Factura N.° <strong>@Model.Factura.Id_Factura</strong></p>
    <p>Subtotal: @Model.Factura.Subtotal.ToString("N0")</p>
    <p>Descuento: @Model.Factura.Descuento.ToString("N0")</p>
    <p class="fs-5">Total a pagar: <strong>@Model.Factura.Total.ToString("N0")</strong></p>

    <form method="post" style="max-width:350px">
        <div class="mb-3">
            <label asp-for="Metodo" class="form-label">Método de pago</label>
            <select asp-for="Metodo" asp-items="Model.Metodos" class="form-select">
                <option value="">Selecciona un método</option>
            </select>
        </div>
        <button type="submit" class="btn btn-primary">Registrar pago</button>
        <a asp-page="Index" class="btn btn-secondary">Cancelar</a>
    </form>
}
