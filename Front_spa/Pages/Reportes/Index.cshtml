@page
@model Front_spa.Pages.Reportes.IndexModel
@{
    ViewData["Title"] = "Reportes";
}

<h2 class="mb-3">Reportes</h2>

<form method="post" style="max-width:500px">

    @if (!string.IsNullOrEmpty(Model.Mensaje))
    {
        <div class="alert alert-danger">@Model.Mensaje</div>
    }

    <div class="mb-3">
        <label class="form-label">Reporte</label>
        <select asp-for="Tipo" class="form-select">
            <option value="Citas">Citas</option>
            <option value="Facturas">Facturas</option>
            <option value="Inventario">Inventario</option>
        </select>
    </div>
    <div class="mb-3">
        <label class="form-label">Desde</label>
        <input asp-for="Desde" type="date" class="form-control" />
    </div>
    <div class="mb-3">
        <label class="form-label">Hasta</label>
        <input asp-for="Hasta" type="date" class="form-control" />
        <div class="form-text">Las fechas aplican a Citas y Facturas. Déjalas vacías para incluir todo.</div>
    </div>

    <input type="submit" value="Descargar PDF" class="btn btn-primary"
           asp-page-handler="BtPdf" />
    <input type="submit" value="Descargar Excel" class="btn btn-secondary"
           asp-page-handler="BtExcel" />

</form>
